{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "customDomainName": {
      "value": "${CUSTOM_DOMAIN_NAME=}"
    },
    "customSubdomain": {
      "value": "${CUSTOM_SUBDOMAIN=}"
    },
    "useSharedInfra": {
      "value": "${USE_SHARED_INFRA=false}"
    },
    "regions": {
      "value": [
        {
          "id": "westus2",
          "location": "westus2",
          "displayName": "West US 2",
          "minReplicas": 0,
          "maxReplicas": 3,
          "isPrimary": true
        },
        {
          "id": "northeurope",
          "location": "northeurope",
          "displayName": "North Europe",
          "minReplicas": 0,
          "maxReplicas": 3,
          "isPrimary": false
        }
      ]
    }
  }
}
