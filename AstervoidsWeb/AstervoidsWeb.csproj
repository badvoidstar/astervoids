<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>31143911-8edd-4435-9a95-b28d6d8722b1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstervoidsWeb.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\shared-config.json" LogicalName="AstervoidsWeb.SharedConfiguration.json" />
    <Content Remove="wwwroot\js\shared-config-data.js" />
    <Content Include="wwwroot\js\shared-config-data.js" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateSharedConfiguration" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_SharedConfigPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'wwwroot', 'shared-config.json'))</_SharedConfigPath>
      <_SharedConfigJson>$([System.IO.File]::ReadAllText('$(_SharedConfigPath)'))</_SharedConfigJson>
      <_SharedConfigScript>globalThis.ASTERVOIDS_SHARED_CONFIG = Object.freeze($(_SharedConfigJson));</_SharedConfigScript>
    </PropertyGroup>
    <WriteLinesToFile File="wwwroot\js\shared-config-data.js"
                      Lines="$([MSBuild]::Escape('$(_SharedConfigScript)'))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>

</Project>
