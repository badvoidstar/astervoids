{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Session": {
    "MaxSessions": 6,
    "MaxMembersPerSession": 4,
    "DistributeOrphanedObjects": true,
    "TrimUpdateMetadata": true,
    "EmptyTimeoutSeconds": 60,
    "AbsoluteTimeoutMinutes": 20
  },
  "Identity": {
    "Provider": "File",
    "PromptOnRoot": true,
    "AllowFileInProduction": false,
    "TableName": "PlayerIdentity",
    "RateLimit": {
      "BrowserPermitLimit": 120,
      "IpPermitLimit": 600,
      "WindowSeconds": 60
    }
  },
  "Leaderboard": {
    "MaxEntries": 50,
    "RateLimit": {
      "QueryIpPermitLimit": 120,
      "ScoreBrowserPermitLimit": 120,
      "ScoreIpPermitLimit": 600,
      "WindowSeconds": 60
    }
  },
  "Region": {
    "Id": "local",
    "DisplayName": "Local",
    "Regions": []
  }
}
